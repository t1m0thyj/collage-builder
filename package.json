{
  "name": "collage-builder",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first browser editor for creating and exporting photo collages.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/t1m0thyj/collage-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t1m0thyj/collage-builder.git"
  },
  "bugs": {
    "url": "https://github.com/t1m0thyj/collage-builder/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --bun run vite",
    "build": "bun --bun run vite build",
    "preview": "bun --bun run vite preview",
    "check": "bun --bun run svelte-check --tsconfig ./tsconfig.app.json && bun --bun run tsc -p tsconfig.tools.json",
    "test": "bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "test:e2e": "bun --bun run playwright test",
    "test:offline": "bun run build --base=/offline-test/ && bun run test:e2e tests/e2e/offline.spec.ts --config=playwright.offline.config.ts --project=chromium --workers=1",
    "test:benchmark": "bun run test:e2e tests/e2e/benchmark.spec.ts --project=chromium --workers=1",
    "generate:layouts": "bun scripts/generate-layout-presets.ts",
    "verify": "bun run format && bun run verify:code",
    "verify:code": "bun run check && bun run lint && bun run test && bun run build",
    "lint": "bun --bun run eslint .",
    "format": "bun --bun run prettier --plugin=prettier-plugin-svelte --check .",
    "format:write": "bun --bun run prettier --plugin=prettier-plugin-svelte --write ."
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "fflate": "^0.8.3",
    "heic-to": "^1.5.2",
    "idb": "^8.0.3",
    "konva": "^10.3.0",
    "svelte-konva": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.29.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "remixicon-svelte": "^0.0.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
